{
  "name": "evening-study-check-in",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted evening self-study attendance and leave management with configurable class sizes.",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "setup": "tsx --env-file=.env.local scripts/setup.ts",
    "demo": "tsx --env-file=.env.local scripts/demo.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "latest",
    "leaflet": "1.9.4",
    "lucide-react": "latest",
    "next": "16.4.3",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
