APP_URL=http://127.0.0.1:3000
# 本地开发可使用文件数据库；Vercel 必须使用远程 libsql/https 数据库。
DATABASE_URL=file:./data/study.db
DATABASE_AUTH_TOKEN=
# Vercel Marketplace 的 Turso 集成也可直接使用以下变量，无需改名。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DEMO_MODE=false
# 仅生成本地虚构数据时使用，不是正式班级的人数限制。
DEMO_STUDENT_COUNT=30
ADMIN_USERNAME=teacher
ADMIN_PASSWORD=
# 公网初始化页面使用；本机开发初始化不要求此项。
SETUP_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 核对公众号实际权限后分别启用；两个接口互不代替。
WECHAT_OAUTH_ENABLED=false
WECHAT_LOCATION_ENABLED=false
WECHAT_VERIFY_FILENAME=
WECHAT_VERIFY_CONTENT=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=
# 可选：持久化唤醒邮件任务，失败仍可从后台重试。
QSTASH_TOKEN=
